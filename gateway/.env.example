# 网关配置（p2.1a）。容器里由 docker-compose 注入；本机直跑 gateway 时 cp 成 .env。
NODE_ENV=development
GATEWAY_PORT=3000
# 用户 JWT 密钥：必须与后端 JWT_SECRET 同值（openssl rand -hex 32 生成）。留空=开发态随机生成。
GATEWAY_JWT_SECRET=
# 网关→后端内部调用共享密钥：必须与后端 INTERNAL_SHARED_SECRET 同值。留空=内部调用不可用。
INTERNAL_SHARED_SECRET=
# 后端地址：容器 http://backend:8000；本机 http://127.0.0.1:8000（避 IPv6 ::1 坑）
GATEWAY_BACKEND_URL=http://127.0.0.1:8000
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
GATEWAY_PROXY_TIMEOUT_MS=180000
# 仅当网关确实躲在会用 $remote_addr 覆盖 XFF 的反代之后才开
GATEWAY_TRUST_PROXY=false
