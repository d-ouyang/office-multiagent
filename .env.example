# ===== 后端服务 =====
APP_NAME=office-multiagent

# ===== MySQL（compose 服务名 mysql） =====
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=office
MYSQL_PASSWORD=office_pass
MYSQL_DATABASE=office
# 初始化 root 密码（仅 init 用，生产请改）
MYSQL_ROOT_PASSWORD=root_pass

# ===== Redis（compose 服务名 redis） =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ===== Chroma（compose 服务名 chroma） =====
# 生产可改为共享 RAG 的 Chroma 地址（设计文档 §12.3）
CHROMA_HOST=chroma
CHROMA_PORT=8000
# chroma 不可用时是否致命：false=健康态降级，不阻断启动
REQUIRE_CHROMA=false

# ===== 连接层加固（p1.2a）=====
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_TIMEOUT=30
REDIS_SOCKET_TIMEOUT=2.0
REDIS_SOCKET_CONNECT_TIMEOUT=2.0
REDIS_HEALTH_CHECK_INTERVAL=30
CHROMA_TIMEOUT=5.0
# 启动探活重试（compose 起停顺序下 DB/Redis 可能晚于 backend 就绪）
CONNECT_MAX_RETRIES=3
CONNECT_RETRY_BACKOFF=1.0

# ===== 日志（设计文档 §十八）=====
LOG_LEVEL=INFO              # DEBUG / INFO / WARNING / ERROR
LOG_FORMAT=json             # json（生产/远端采集）/ text（本地调试）

# ===== 鉴权（§13.3；参考 RAG internal-auth.client.ts；用户点5）=====
# 用户 JWT 共享密钥（网关 passport-jwt 签、后端 PyJWT 验，二者共用，绝不空）
JWT_SECRET=
# 服务间内部调用共享密钥（网关↔后端走 X-Internal-Token，hmac 比对，fail-closed）
INTERNAL_SHARED_SECRET=

# ===== 网关（Phase 2；复用上面的 JWT_SECRET / INTERNAL_SHARED_SECRET）=====
NODE_ENV=development
GATEWAY_PORT=3000
# GATEWAY_JWT_SECRET 需与上面的 JWT_SECRET 同值（留空=开发态随机生成）
GATEWAY_JWT_SECRET=
GATEWAY_BACKEND_URL=http://backend:8000
GATEWAY_ALLOWED_ORIGINS=http://localhost:8080
GATEWAY_PROXY_TIMEOUT_MS=180000
# ---- p6.1 登录链路 ----
# JWT/内部密钥：生产必须 openssl rand -hex 32；两值须网关/后端一致
GATEWAY_JWT_SECRET=
INTERNAL_SHARED_SECRET=
# ---- 云端模型密钥（Brain 真调用；不配则 Agent 回落确定性基线）----
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
# backend 调 RAG 检索工具（容器内必须 host.docker.internal，127.0.0.1 是容器自己）
RAG_BASE_URL=http://host.docker.internal:8000
# 共享网关（p5.0）：RAG 上游 + 限流（多上游/前缀/公开规则见 gateway/config/routes.yaml）
RAG_BACKEND_URL=http://host.docker.internal:8000
# 网关证明密钥：须与 RAG 后端 OFFICE_GATEWAY_SHARED_SECRET 同值（rag p4.11）。留空=不注入身份
RAG_INTERNAL_SECRET=
GATEWAY_RATE_LIMIT_MAX=600
GATEWAY_RATE_LIMIT_WINDOW_MS=60000

# ===== 模型注册表（配置驱动，§十七）=====
# 留空则自动定位 backend/config/models.yaml
MODELS_CONFIG=

# ===== 云端模型密钥（仅环境变量，不进 git；用户点6：全云端）=====
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=

# ===== 对外端口（宿主机映射） =====
BACKEND_PORT=8000
FRONTEND_PORT=8080
