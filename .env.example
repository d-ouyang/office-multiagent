# ===== 后端服务 =====
APP_NAME=office-multiagent

# ===== MySQL（compose 服务名 mysql） =====
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=office
MYSQL_PASSWORD=office_pass
MYSQL_DATABASE=office
# 初始化 root 密码（仅 init 用，生产请改）
MYSQL_ROOT_PASSWORD=root_pass

# ===== Redis（compose 服务名 redis） =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ===== Chroma（compose 服务名 chroma） =====
# 生产可改为共享 RAG 的 Chroma 地址（设计文档 §12.3）
CHROMA_HOST=chroma
CHROMA_PORT=8000
# chroma 不可用时是否致命：false=健康态降级，不阻断启动
REQUIRE_CHROMA=false

# ===== 日志（设计文档 §十八）=====
LOG_LEVEL=INFO              # DEBUG / INFO / WARNING / ERROR
LOG_FORMAT=json             # json（生产/远端采集）/ text（本地调试）

# ===== 鉴权（§13.3；参考 RAG internal-auth.client.ts；用户点5）=====
# 用户 JWT 共享密钥（网关 passport-jwt 签、后端 PyJWT 验，二者共用，绝不空）
JWT_SECRET=
# 服务间内部调用共享密钥（网关↔后端走 X-Internal-Token，hmac 比对，fail-closed）
INTERNAL_SHARED_SECRET=

# ===== 模型注册表（配置驱动，§十七）=====
# 留空则自动定位 backend/config/models.yaml
MODELS_CONFIG=

# ===== 云端模型密钥（仅环境变量，不进 git；用户点6：全云端）=====
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=

# ===== 对外端口（宿主机映射） =====
BACKEND_PORT=8000
FRONTEND_PORT=8080
